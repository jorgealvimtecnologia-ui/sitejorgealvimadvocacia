<%- include('../partials/header', { pageTitle: 'Enviar Monografia' }) %>

<h1 class="text-2xl font-semibold mb-6">Enviar monografia</h1>

<% if (error) { %>
  <div class="mb-4 bg-rose-50 border border-rose-200 text-rose-700 text-sm px-4 py-3 rounded-lg"><%= error %></div>
<% } %>

<form action="/painel/autor/novo" method="POST" enctype="multipart/form-data"
      class="bg-white border border-slate-200 rounded-xl p-6 space-y-5 max-w-2xl">
  <div>
    <label class="block text-sm font-medium mb-1">Título</label>
    <input name="title" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Resumo (abstract)</label>
    <textarea name="abstract" rows="5" required class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm"></textarea>
  </div>
  <div class="grid grid-cols-2 gap-4">
    <div>
      <label class="block text-sm font-medium mb-1">Área</label>
      <input name="area" placeholder="Ex.: Direito Militar" class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
    </div>
    <div>
      <label class="block text-sm font-medium mb-1">Preço (R$)</label>
      <input name="price" type="text" inputmode="decimal" placeholder="49,90" required
             class="w-full border border-slate-300 rounded-lg px-3 py-2 text-sm" />
    </div>
  </div>
  <div>
    <label class="block text-sm font-medium mb-1">Arquivo PDF</label>
    <input name="pdf" type="file" accept="application/pdf" required
           class="w-full text-sm file:mr-3 file:px-4 file:py-2 file:rounded-lg file:border-0 file:bg-slate-900 file:text-white" />
    <p class="text-xs text-slate-400 mt-1">Somente PDF, até 40&nbsp;MB. O arquivo fica em área privada até a aprovação.</p>
  </div>
  <button class="bg-slate-900 text-white text-sm px-5 py-2.5 rounded-lg hover:bg-slate-700">Enviar para moderação</button>
</form>

<%- include('../partials/footer') %>
