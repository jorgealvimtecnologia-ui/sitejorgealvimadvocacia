# ======= Ambiente =======
NODE_ENV=production
PORT=3000
BASE_URL=https://jorgealvimadvocacia.com.br

# ======= Banco (SQLite) =======
DB_PATH=/var/data/marketplace.db

# ======= Armazenamento privado dos PDFs (FORA do /public) =======
PRIVATE_UPLOADS_DIR=/var/data/monografias
MAX_PDF_BYTES=41943040

# ======= Segurança =======
# Gere com:  npm run genkey
TOKEN_ENCRYPTION_KEY=coloque_64_chars_hex_aqui
SESSION_SECRET=troque_por_um_segredo_longo_aleatorio

# ======= Mercado Pago (aplicação Marketplace) =======
MP_CLIENT_ID=seu_app_id
MP_CLIENT_SECRET=seu_client_secret
MP_PUBLIC_KEY=public_key_do_integrador
MP_REDIRECT_URI=https://jorgealvimadvocacia.com.br/oauth/callback
MP_WEBHOOK_SECRET=secret_configurado_no_painel_de_webhooks

# ======= Regras de negócio =======
PLATFORM_FEE_PERCENT=15
DOWNLOAD_TOKEN_HOURS=48
DOWNLOAD_MAX_USES=5
