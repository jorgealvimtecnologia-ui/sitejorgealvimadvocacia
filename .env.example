# ============================================================
#  Jorge Alvim Advocacia — Variáveis de Ambiente (exemplo)
#  Copie para .env e preencha. NUNCA versione o .env real.
# ============================================================

# Ambiente: development | production
NODE_ENV=development

# Porta do servidor Node
PORT=3000

# ---- Senha inicial do Usuário Mestre ----
# Usada APENAS na 1ª criação do mestre (banco novo). Se vazia, o sistema gera uma
# senha aleatória forte e a imprime uma única vez no log de boot. Depois de criado,
# o mestre NUNCA tem a senha reescrita no boot — troque pelo painel (Redefinir
# senha) ou por: node scripts/set-master-password.js "NovaSenha". NUNCA versione a
# senha real (só o .env real, que é ignorado pelo git).
MASTER_PASSWORD=

# Origens permitidas para CORS (separadas por vírgula).
# Ex.: https://jorgealvimadvocacia.com.br,https://www.jorgealvimadvocacia.com.br
# Vazio = permite qualquer origem (apenas para desenvolvimento).
ALLOWED_ORIGINS=

# ---- Integração Asaas (Financeiro / NFS-e) ----
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3

# ---- SEO / Analytics / Marketing (injetados no index.html ao servir) ----
# Se ficarem VAZIOS, os blocos correspondentes são removidos do HTML —
# sem erro no console e sem pixel/tag quebrado. Preencha para ativar.
# Meta Pixel (Facebook/Instagram) — só o número do ID (ex.: 1234567890).
META_PIXEL_ID=
# Google Analytics 4 — ID de medição (ex.: G-H4K6S068SW).
GA_MEASUREMENT_ID=
# Google Tag Manager — ID do contêiner (ex.: GTM-XXXXXXX). Se preenchido, gerencia GA4 e Ads.
GTM_CONTAINER_ID=
# Google Ads — ID de conversão/tag (ex.: AW-XXXXXXXXX).
GOOGLE_ADS_ID=
# Google Maps Embed API Oficial — Chave de API Google Cloud (opcional; se vazio, usa embed livre)
GOOGLE_MAPS_API_KEY=
# Google reCAPTCHA v3 — Chave pública do site e chave secreta para validação anti-robô invisível
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5
# Verificação de domínio do Meta Business Suite (a chave do Business Manager).
META_BUSINESS_VERIFICATION=
# Verificação do Google Search Console via meta tag (opcional; a verificação
# por arquivo /google...html já está ativa no server.js).
GSC_VERIFICATION=

# ---- Integração Meta Ads & Marketing (Facebook & Instagram API) ----
META_INSTAGRAM_ACCOUNT_ID=17841460928822628
META_AD_ACCOUNT_ID=705653348893835
META_PAGE_ID=696494846890195
META_WHATSAPP_ACCOUNT_ID=114822078371308
META_SYSTEM_USER_TOKEN=

# ---- Sincronização local de intimações (scripts/sync-intimacoes-local.js) ----
# URL do sistema em produção que receberá as intimações baixadas no Brasil.
PROD_URL=https://jorgealvimadvocacia.com.br
# Credenciais usadas pelo script de sync local para autenticar na API.
SYNC_USER=
SYNC_PASS=

# ---- Proxy BR para a ComunicaAPI/DJEN (se o sync rodar no servidor França) ----
# Aponte para um proxy no Brasil (ex.: http://usuario:senha@ip:porta).
# Vazio = fetch direto (funciona só de dentro do Brasil).
COMUNICA_PROXY=

# ---- Entrega de código de acesso via WhatsApp (Central Segura de Acesso) ----
# Gateway HTTP que dispara a mensagem ao WhatsApp do escritório. Se ficar VAZIO,
# o WhatsApp não é enviado (o código continua chegando na notificação do painel).
WHATSAPP_GATEWAY_URL=
WHATSAPP_API_KEY=
# Número do advogado que recebe as notificações (padrão institucional se vazio).
LAWYER_WHATSAPP_NUMBER=

# ---- Entrega de código de acesso via E-mail (SMTP) ----
# Alternativa ao WhatsApp. Se ficar VAZIO, o e-mail não é enviado (o código
# continua chegando na notificação do painel do mestre).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Remetente exibido (opcional; padrão = SMTP_USER).
SMTP_FROM=
# "true" para SSL direto; automático quando SMTP_PORT=465.
SMTP_SECURE=

# ---- Outras integrações futuras ----
# JWT_SECRET=

# ---- Cofre do .env e aviso de alterações (ver docs/INFRA.md) ----
# Segredos NÃO ficam em texto puro no servidor: ficam em .env.enc (node scripts/env-vault.js migrate).
# A chave do cofre fica FORA do projeto (padrão /etc/advocacia/env.key, permissão 600). Alternativa: ENV_VAULT_KEY.
# NUNCA coloque a chave aqui nem no repositório.
ENV_VAULT_KEY_FILE=
# E-mail que recebe o aviso a cada alteração do .env (relatório só com nomes + cofre criptografado).
ENV_CHANGE_NOTIFY_TO=jorgealvimtecnologia@gmail.com
# "1" desativa o vigia de alterações do .env (não recomendado).
ENV_WATCH_DISABLED=

# ---- Alertas de prazo por WhatsApp/e-mail (só para advogados; ver docs/ALERTAS-DE-PRAZO.md) ----
# Endereço público do site, usado no link de "confirmar ciência" enviado ao advogado.
SITE_URL=https://jorgealvimadvocacia.com.br
# Segredo que assina os links de ciência (opcional: sem ele o sistema gera um e guarda no banco). Vai para o cofre.
DEADLINE_ACK_SECRET=
# "1" desativa o envio automático de alertas de prazo externos.
DEADLINE_ALERTS_DISABLED=

# ---- Login com Google (ver docs/SECURITY.md) ----
# Client IDs aceitos como destinatário do token do Google (separados por vírgula), além do GOOGLE_CLIENT_ID.
# Só preencha se o site usar mais de um Client ID.
GOOGLE_ALLOWED_AUDIENCES=
# NÃO use em produção. Libera o "token de teste" do Google só em desenvolvimento local (nunca vale com NODE_ENV=production).
ALLOW_MOCK_GOOGLE_TOKEN=

# Chave da API pública do DataJud (CNJ), usada no Radar Judicial. Confira a chave vigente no portal do CNJ.
# Em produção: node scripts/env-vault.js set DATAJUD_API_KEY (vai para o cofre criptografado).
DATAJUD_API_KEY=

# ---- Radar Judicial via Escavador Business (ver docs/RADAR-ESCAVADOR.md) ----
# Funciona do servidor na França (não precisa de proxy, ao contrário da ComunicaAPI/DJEN).
# Token da API (server-to-server; criado no painel https://api.escavador.com/tokens).
# Em produção: node scripts/env-vault.js set ESCAVADOR_API_TOKEN (vai para o cofre criptografado).
ESCAVADOR_API_TOKEN=
# Token que VALIDA os callbacks do Escavador (gere um aleatório e cadastre no painel de callbacks).
# Em produção: node scripts/env-vault.js set ESCAVADOR_CALLBACK_TOKEN
ESCAVADOR_CALLBACK_TOKEN=
# Base da API (opcional; padrão https://api.escavador.com/api/v1).
ESCAVADOR_API_BASE=
# Proxy opcional (normalmente DESNECESSÁRIO: a API do Escavador funciona de fora do Brasil).
ESCAVADOR_PROXY=
